PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://pet:adminnnnnnnnnnnnnnnnnnnnnnNa@localhost:5432/bugpet?schema=public"
JWT_SECRET=change_me_to_a_long_random_string

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Docker & Traefik
TRAEFIK_NETWORK=petbug_net
BASE_LAB_DOMAIN=127.0.0.1.nip.io
# http (local) | https (production) — used to build lab instance URLs
LAB_URL_SCHEME=
DOCKER_HOST=

# Route reload strategy for the Traefik file provider:
#   restart (default, works on Docker Desktop) | watch (Linux hosts)
TRAEFIK_RELOAD=restart

# Refuse to pull missing lab images when set to false (offline / air-gapped demos)
LAB_ALLOW_PULL=true

# Lab readiness gate: the API reports RUNNING only after the target answers a
# request. It probes the container directly by default. If the API cannot reach
# the container (e.g. it is not on the lab network), set TRAEFIK_LAB_PROBE=true
# to probe through Traefik; tune the budget for slow-starting images.
TRAEFIK_LAB_PROBE=false
TRAEFIK_HOST=traefik
TRAEFIK_HTTP_PORT=80
LAB_READY_TIMEOUT_MS=60000

# Token lifetimes
ACCESS_TOKEN_TTL=8h
REFRESH_TOKEN_TTL=30d
