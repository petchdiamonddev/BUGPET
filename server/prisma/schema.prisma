generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ROLE {
  ADMIN
  USER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum InstanceStatus {
  STARTING
  RUNNING
  STOPPED
  ERROR
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  email        String        @unique
  password     String
  role         ROLE          @default(USER)
  points       Int           @default(0)
  bio          String?
  avatarColor  String?
  isBanned     Boolean       @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  labInstances LabInstance[]
  solves       Solve[]
  badges       UserBadge[]

  @@index([points(sort: Desc)])
}

model Lab {
  id          Int           @id @default(autoincrement())
  title       String
  description String
  difficulty  Difficulty    @default(EASY)
  dockerImage String
  flag        String
  points      Int           @default(100)
  timeoutMin  Int           @default(60)
  isActive    Boolean       @default(true)
  tags        String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  instances   LabInstance[]
  solves      Solve[]
}

model LabInstance {
  id          String         @id @default(cuid())
  userId      Int
  labId       Int
  containerId String?
  subdomain   String         @unique
  status      InstanceStatus @default(STARTING)
  startedAt   DateTime       @default(now())
  expiresAt   DateTime
  stoppedAt   DateTime?
  stopReason  String?
  error       String?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab         Lab            @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
}

model Solve {
  id       Int      @id @default(autoincrement())
  userId   Int
  labId    Int
  solvedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab      Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
  @@index([labId, solvedAt])
}

model Badge {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String
  icon        String
  condition   String
  tier        String      @default("BRONZE")
  points      Int         @default(0)

  userBadges  UserBadge[]
}

model UserBadge {
  userId   Int
  badgeId  Int
  earnedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}
