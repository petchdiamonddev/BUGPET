# PETBUG SPA + API gateway (rendered from this template at container start;
# nginx's envsubst replaces ${API_UPSTREAM} and ${NGINX_RESOLVER}).
#
# Traefik routes the public host to this container; nginx serves the SPA and
# proxies /api to the API container on the same Docker network.

server {
    listen 80;
    server_name _;

    # Docker's embedded DNS (needed for a dynamic upstream).
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    # Set the upstream through a variable so the container still starts (and
    # serves the SPA) even if the API is not up yet; nginx re-resolves it.
    set $api_upstream http://${API_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;

    # Container healthcheck target.
    location = /healthz {
        access_log off;
        add_header Cache-Control "no-store";
        return 200 "ok\n";
    }

    # API proxy. `$http_host` preserves the public hostname so URLs and
    # redirects generated by the API point at the real domain.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }

    # Hashed build assets are immutable.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html must never be cached, otherwise deploys pin an old bundle.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # SPA fallback for client-side routes (/labs/3, /admin, …).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Basic hardening (TLS termination and HSTS live in Traefik).
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
}
