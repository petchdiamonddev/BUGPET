# PETBUG — production environment
# Copy to `.env` next to docker-compose.yml and fill every secret.
# Never commit the real file (it is git-ignored).

# ---------------------------------------------------------------- domain
# Public hostname of the app (SPA + API).
APP_HOST=petbug.example.com
# Wildcard base for lab instances: a lab is served at <token>.<LAB_BASE_DOMAIN>
# and MUST match the DNS A/AAAA record: *.lab.example.com
LAB_BASE_DOMAIN=lab.example.com
# Let admins log in with the seeded credentials on first boot.
SEED_ON_START=false

# ---------------------------------------------------------------- secrets
POSTGRES_PASSWORD=change_me_to_a_long_random_string
JWT_SECRET=change_me_to_at_least_32_random_characters
REDIS_PASSWORD=change_me_to_another_random_string

# ---------------------------------------------------------------- tls
# Disable for a LAN/VPS demo over plain HTTP (labs are then served over http).
TLS_ENABLED=true
# Required by Let's Encrypt when TLS_ENABLED=true.
ACME_EMAIL=you@example.com
# Use the Let's Encrypt staging CA while testing to avoid rate limits.
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
